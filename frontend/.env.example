# Public values only. NEVER put APP_KEY, database credentials or the Reverb *secret* here.

# true  = run on the in-memory mock backend (default, no Laravel needed)
# false = talk to the real Laravel API
VITE_USE_MOCKS=true

# Laravel base URL (leave empty to use the Vite proxy defined in vite.config.js)
VITE_API_URL=

# Laravel Reverb (public values from your Laravel .env: REVERB_APP_KEY / host / port)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
